# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

cat >> .gitignore <<'EOF'

# Python
__pycache__/
*.py[cod]
*.pyo

# Local database
*.db
*.sqlite
*.sqlite3

# Generated backend files
backend/storage/uploads/
backend/storage/heatmaps/
backend/storage/reports/

# Local runtime files
*.log
EOF