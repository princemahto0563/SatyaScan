# ==============================================================================
# SatyaScan Deployment Configuration Environment Template
# Problem Statement: SIH26188 (MHA / Sashastra Seema Bal)
# ==============================================================================
# IMPORTANT: Copy this file to .env and configure strong values for production.
# Never commit .env containing real credentials into version control.

# Core Settings
PROJECT_NAME="SatyaScan"
VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production

# API Security
# In production, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="change-this-to-a-cryptographically-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Whitelist (Comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
# Default: Embedded SQLite for air-gapped zero-cloud checkpoint stations
# Production: postgresql://user:password@localhost:5432/satyascan
DATABASE_URL="sqlite:///./satyascan.db"

# Storage Directories (Absolute or relative to backend)
STORAGE_DIR="./storage"

# OCR Engine Priority: paddleocr | tesseract | mock
OCR_ENGINE="paddleocr"

# Frontend Environment Variable (used by Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
